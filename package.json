{
  "name": "origin-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Public marketing website for Origin — a developer workspace and project launcher.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
